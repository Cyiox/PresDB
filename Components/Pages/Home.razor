@page "/"
@rendermode InteractiveServer

<PageTitle>Home - WebPresDB</PageTitle>

<div class="row align-items-end mb-4">
    <div class="col-lg-8"></div>

    <div class="panel-shell">
        <div class="row g-4 align-items-start">
            <div class="mini-search-panel">
                <h3 class="h5 mb-3">Property search</h3>

                <!-- Blazor Native Form handling -->
                <form @onsubmit="HandleSearchSubmit" class="d-grid gap-3">
                    <div>
                        <label class="form-label" for="q">Search term</label>
                        <input class="form-control" type="text" id="q" placeholder="Project ID, name, city, address"
                               value="@searchTerm" @oninput="OnSearchTermInput" />
                    </div>

                    <div class="row g-2">
                        <div class="col-sm-6">
                            <label class="form-label" for="project_city">City</label>
                            <input class="form-control" type="text" id="project_city" value="@projectCity"
                                   @oninput="OnCityInput" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="property_id">Project ID</label>
                            <input class="form-control" type="text" id="property_id" value="@propertyId"
                                   @oninput="OnPropertyIdInput" />
                        </div>
                    </div>

                    <details class="advanced-filters">
                        <summary>Advanced filtering</summary>
                        <fieldset class="mt-3">
                            <legend class="form-label mb-2">HUD contract program type group code contains</legend>
                            <div class="d-flex flex-wrap gap-3">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" value="PRAC"
                                           checked=@(hudProgramTypeGroupCodes.Contains("PRAC"))
                                           @onchange="@(eventArgs => OnHudCodeChanged("PRAC", eventArgs))" />
                                    <span class="form-check-label">PRAC</span>
                                </label>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" value="202"
                                           checked=@(hudProgramTypeGroupCodes.Contains("202"))
                                           @onchange="@(eventArgs => OnHudCodeChanged("202", eventArgs))" />
                                    <span class="form-check-label">202</span>
                                </label>
                            </div>
                        </fieldset>
                    </details>

                    <button class="btn btn-primary btn-lg" type="submit" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Search properties
                    </button>
                </form>
            </div>
        </div>

        <!-- Dynamic Results Container -->
        <div id="search-results" class="mt-4">
            @if (isLoading)
            {
                <p class="text-muted">Searching...</p>
            }
            else if (hasSearched)
            {
                <SearchResultsList @key="searchVersion" SearchTerm="@searchTerm" City="@projectCity"
                                   PropertyId="@propertyId" HudProgramTypeGroupCodes="@hudProgramTypeGroupCodes" />
            }
        </div>
    </div>
</div>

@code {
    private string searchTerm = "";
    private string projectCity = "";
    private string propertyId = "";
    private readonly HashSet<string> hudProgramTypeGroupCodes = new(StringComparer.OrdinalIgnoreCase);

    private bool isLoading = false;
    private bool hasSearched = false;

    private int searchVersion;
    private CancellationTokenSource? debounceCts;

    // Replicating HTMX's delay:400ms debounce behavior for typing
    private async Task OnSearchTermInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        await DebounceSearchAsync();
    }

    private async Task OnCityInput(ChangeEventArgs e)
    {
        projectCity = e.Value?.ToString() ?? "";
        await DebounceSearchAsync();
    }

    private async Task OnPropertyIdInput(ChangeEventArgs e)
    {
        propertyId = e.Value?.ToString() ?? "";
        await DebounceSearchAsync();
    }

    private async Task OnHudCodeChanged(string code, ChangeEventArgs e)
    {
        if (e.Value is true || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase))
        {
            hudProgramTypeGroupCodes.Add(code);
        }
        else
        {
            hudProgramTypeGroupCodes.Remove(code);
        }

        await ExecuteSearchAsync();
    }

    private async Task DebounceSearchAsync()
    {
        debounceCts?.Cancel();
        debounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(400, debounceCts.Token);
            await ExecuteSearchAsync();
        }
        catch (TaskCanceledException)
        {
            // Ignore if the user kept typing before 400ms finished
        }
    }

    private async Task HandleSearchSubmit()
    {
        debounceCts?.Cancel(); // Cancel any pending live search
        await ExecuteSearchAsync();
    }

    private async Task ExecuteSearchAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            hasSearched = true;
            searchVersion++;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}