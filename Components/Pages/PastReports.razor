@page "/past-reports"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using WebPresDB.Models
@inject PreservationTestContext Db

<PageTitle>Past Reports - WebPresDB</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <p class="text-uppercase text-muted small fw-semibold mb-1">Massachusetts preservation inventory</p>
        <h1 class="h2 mb-1">Past Reports</h1>
        <p class="text-muted mb-0">Review preservation reports saved in the report archive.</p>
    </div>
    <a class="btn btn-primary" href="reports">Create new report</a>
</div>

@if (isLoading)
{
    <p class="text-muted">Loading past reports...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (reportRuns.Count == 0)
{
    <div class="border rounded p-5 text-center text-muted">
        <h2 class="h5 text-body">No past reports found</h2>
        <p class="mb-0">Generated reports will appear here when they are saved to the archive.</p>
    </div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Report</th>
                    <th>Forecast date</th>
                    <th>Generated</th>
                    <th>Generated by</th>
                    <th class="text-end">Properties</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in reportRuns)
                {
                    <tr>
                        <td>@(run.ReportName ?? "Preservation report")</td>
                        <td>@run.ReportAtRiskDate.ToString("MMMM d, yyyy")</td>
                        <td>@run.ReportRunDateTime.ToString("MMMM d, yyyy h:mm tt")</td>
                        <td>@(run.ReportUsername ?? "Unknown")</td>
                        <td class="text-end">@run.PropertyCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private readonly List<ReportRun> reportRuns = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rows = await Db.AtRiskReportDataArchives
                .AsNoTracking()
                .OrderByDescending(row => row.ReportRunDateTime)
                .ToListAsync();

            reportRuns.AddRange(rows
                .GroupBy(row => new { row.ReportRunDateTime, row.ReportAtRiskDate, row.ReportName, row.ReportUsername })
                .Select(group => new ReportRun(
                    group.Key.ReportName,
                    group.Key.ReportAtRiskDate,
                    group.Key.ReportRunDateTime,
                    group.Key.ReportUsername,
                    group.Select(row => row.PropertyId).Distinct().Count())));
        }
        catch (Exception exception)
        {
            errorMessage = $"Past reports could not be loaded: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed record ReportRun(
        string? ReportName,
        DateTime ReportAtRiskDate,
        DateTime ReportRunDateTime,
        string? ReportUsername,
        int PropertyCount);
}
