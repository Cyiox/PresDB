@page "/past-reports"
@rendermode InteractiveServer
@inject PublishedReportStorageService ReportStorage

<PageTitle>Past Reports - WebPresDB</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <p class="text-uppercase text-muted small fw-semibold mb-1">Massachusetts preservation inventory</p>
        <h1 class="h2 mb-1">Past Reports</h1>
        <p class="text-muted mb-0">Open official published preservation reports.</p>
    </div>
    <a class="btn btn-primary" href="reports">Create new report</a>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (reports is null)
{
    <p class="text-muted">Loading published reports...</p>
}
else if (reports.Count == 0)
{
    <div class="border rounded p-5 text-center text-muted">
        <h2 class="h5 text-body">No published reports found</h2>
        <p class="mb-0">Published PDF reports will appear here when they are added to the report archive.</p>
    </div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Published report</th>
                    <th>Last updated</th>
                    <th>Size</th>
                    <th class="text-end">Open</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in reports)
                {
                    <tr>
                        <td>@report.Name</td>
                        <td>@report.LastUpdated.ToString("MMMM d, yyyy")</td>
                        <td class="text-muted small">@FormatSize(report.Size)</td>
                        <td class="text-end">
                            <a class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener"
                               href="@GetReportHref(report.Name)">Open PDF</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<PublishedReportFile>? reports;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        try
        {
            reports = ReportStorage.GetReports();
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or DirectoryNotFoundException)
        {
            errorMessage = $"Published reports could not be loaded: {exception.Message}";
        }
    }

    private static string GetReportHref(string fileName) =>
        $"/published-report-files/{Uri.EscapeDataString(fileName)}";

    private static string FormatSize(long bytes) =>
        bytes switch
        {
            >= 1024 * 1024 => $"{bytes / (1024d * 1024d):0.0} MB",
            >= 1024 => $"{bytes / 1024d:0.0} KB",
            _ => $"{bytes} bytes"
        };
}
