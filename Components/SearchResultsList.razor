@using WebPresDB.Models

<table class="table table-hover">
    <thead>
        <tr>
            <th>Project ID</th>
            <th>Name</th>
            <th>City</th>
            <th>Address</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var property in Properties)
        {
            <tr>
                <td>@property.PropertyId</td>
                <td>@property.Name</td>
                <td>@property.City</td>
                <td>@property.Address</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter]
    public List<PropertyModel> Properties { get; set; } = new();
}